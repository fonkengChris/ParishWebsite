# ============================================================================
# Backend environment variables
# Copy to .env for local dev. On Render/Railway/etc. set these in the
# platform's Environment/Secrets UI — never commit real values.
# ============================================================================

# --- Server ---
# PORT is usually injected by the host (Render/Railway). Leave unset in prod.
PORT=5000
NODE_ENV=development

# --- Database (MongoDB) ---
# Local:  mongodb://localhost:27017/parish-website
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/parish-website?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/parish-website

# --- Authentication ---
# Use a long random string in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-production

# --- CORS / URLs ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# In production this MUST include your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Public URL of the frontend (used in emails / payment redirects, and for the
# links the chatbot puts in its replies). In production this MUST be set to your
# deployed frontend URL, otherwise chatbot links point at localhost.
FRONTEND_URL=http://localhost:3000
# Public URL of this backend (used for payment callbacks).
BACKEND_URL=http://localhost:5000

# --- Scheduler ---
# IANA timezone for the daily liturgical-color cron. Parish default: Africa/Douala (Cameroon).
SCHEDULER_TIMEZONE=Africa/Douala

# --- Parish Assistant / Chatbot ---
# The chatbot uses OpenAI (gpt-4.1-nano) via the Vercel AI SDK. Without an API
# key it falls back to keyword-based rule replies, so the widget still works.
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4.1-nano
# CHAT_ENABLED=true

# --- Parish identity (fallbacks) ---
# Used only until the ParishConfig singleton is populated in the DB (via the
# admin "Parish Settings" page or `npm run seed-parish`). Once seeded, the DB
# document is the source of truth and these are ignored.
PARISH_NAME=St. John of God Parish
PARISH_DIOCESE=Buea Diocese
PARISH_DIOCESE_URL=https://bueadiocese.org
PARISH_CITY=Limbe
PARISH_REGION=Southwest Region
PARISH_COUNTRY=Cameroon
PARISH_COORDINATES=4.055278,9.228056
PARISH_NEIGHBOURHOOD=Bonadikombo
PARISH_ADDRESS=Bonadikombo, Limbe
PARISH_PHONE=+237 333 22 11 00
PARISH_TAGLINE=Holy Ground
PARISH_PATRON_NAME=St. John of God
PARISH_PATRON_DESCRIPTOR=Patron of the Sick

# --- Email (SMTP) — optional ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Parish Website
PARISH_CONTACT_EMAIL=parish@example.com

# --- WhatsApp / SMS (Twilio) — optional ---
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_PHONE_NUMBER=+1234567890

# --- Donations: PayPal — optional ---
# PAYPAL_MODE=sandbox            # sandbox | live
# PAYPAL_CLIENT_ID=your-client-id
# PAYPAL_CLIENT_SECRET=your-client-secret

# --- Donations: MTN Mobile Money (Cameroon) — optional ---
# MTN_ENVIRONMENT=sandbox        # sandbox | mtncameroon
# MTN_SUBSCRIPTION_KEY=your-subscription-key
# MTN_API_USER_UUID=your-api-user-uuid
# MTN_API_KEY=your-api-key
# MTN_API_SECRET=your-api-secret
# MTN_CURRENCY=EUR               # EUR in sandbox, XAF in production
