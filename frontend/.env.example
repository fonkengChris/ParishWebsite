# ============================================================================
# Frontend environment variables (Vite)
# Copy to .env.local for local dev. On Vercel/Netlify set these in the
# platform's Environment Variables UI. Only VITE_* vars are exposed to the app.
# ============================================================================

# Base URL of the backend API.
# - Leave UNSET for local dev: requests to /api are proxied to localhost:5000
#   by vite.config.ts.
# - In production set it to your deployed backend, e.g.
#     https://your-backend.onrender.com
#   (the "/api" suffix is added automatically if missing).
# VITE_API_URL=https://your-backend.onrender.com
